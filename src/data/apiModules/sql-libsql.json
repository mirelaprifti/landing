						"kind": "interface",
						"description": [],
						"signature": {
							"lang": "ts",
							"code": "export interface Base {\n  readonly spanAttributes?: Record<string, unknown> | undefined\n  readonly transformResultNames?: ((str: string) => string) | undefined\n  readonly transformQueryNames?: ((str: string) => string) | undefined\n}"
						},
