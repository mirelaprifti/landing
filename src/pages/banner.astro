---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Effect 4.0 — Now in Beta"
  description="Effect 4.0 is now in beta."
>
  <main class="relative flex h-screen w-full items-center justify-center overflow-hidden bg-zinc-950">
    <!-- Grid background (same treatment as the hero sections) -->
    <div
      class="pointer-events-none absolute inset-0"
      style="background-image: linear-gradient(to right, rgba(24, 24, 27, 0.8) 1px, transparent 1px), linear-gradient(to bottom, rgba(24, 24, 27, 0.8) 1px, transparent 1px); background-size: 196.6px 171px; background-position: calc(50% + 97px) 0;"
    >
    </div>
    <div
      class="pointer-events-none absolute inset-0"
      style="background: linear-gradient(to bottom, #09090b 0%, transparent 20%, transparent 60%, #09090b 100%);"
    >
    </div>
    <!-- Subtle glow -->
    <div
      class="pointer-events-none absolute inset-x-0 top-0 h-[400px]"
      style="background: radial-gradient(ellipse 50% 80% at 70% -20%, rgba(255, 255, 255, 0.08) 0%, transparent 50%), radial-gradient(ellipse 30% 50% at 80% 0%, rgba(255, 255, 255, 0.05) 0%, transparent 40%);"
    >
    </div>

    <p class="relative font-mono text-2xl font-medium tracking-wider text-white md:text-4xl">
      <span class="text-zinc-500" aria-hidden="true">{"// "}</span>Effect 4.0 — Now in Beta
    </p>
  </main>
</BaseLayout>

<style is:global>
  /* Keep the dev toolbar out of screen captures */
  astro-dev-toolbar {
    display: none !important;
  }
</style>
