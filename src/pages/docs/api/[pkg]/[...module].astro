---
// Legacy unversioned URLs redirect to the v3 reference.
import { readdirSync, readFileSync } from "node:fs";
import { join } from "node:path";

export function getStaticPaths() {
	const dir = join(process.cwd(), "src/data/apiModules/");
	return readdirSync(dir)
		.filter((file) => file.endsWith(".json"))
		.flatMap((file) => {
			const pkg = file.replace(/\.json$/, "");
			const modules = JSON.parse(readFileSync(join(dir, file), "utf8"));
			return Object.keys(modules).map((module) => ({
				params: { pkg, module },
			}));
		});
}

return Astro.redirect(
	`/docs/api/v3/${Astro.params.pkg}/${Astro.params.module}`,
);
---
