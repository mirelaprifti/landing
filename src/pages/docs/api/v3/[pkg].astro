---
import { ApiReferencePackagePage } from "@/components/landing/ApiReferencePage";
import { API_PACKAGES } from "@/components/landing/apiReferenceData";
import BaseLayout from "../../../../layouts/BaseLayout.astro";

export function getStaticPaths() {
	return API_PACKAGES.map((pkg) => ({ params: { pkg: pkg.slug } }));
}

const { pkg: slug } = Astro.params;
const pkg = API_PACKAGES.find((p) => p.slug === slug)!;
---

<BaseLayout
  themeable
  title={`${pkg.name} — Effect API Reference`}
  description={pkg.description}
>
  <ApiReferencePackagePage slug={pkg.slug} client:load />
</BaseLayout>
