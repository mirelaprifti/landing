---
import { Code } from "astro:components";
import { readdirSync, readFileSync } from "node:fs";
import { join } from "node:path";
import {
	ApiReferenceLayout,
	type ApiTocItem,
} from "@/components/landing/ApiReferencePage";
import { API_PACKAGES } from "@/components/landing/apiReferenceData";
import { getAssetPath } from "@/utils/assetPath";
import BaseLayout from "../../../../../layouts/BaseLayout.astro";

type ApiCodeBlock = { lang: string; code: string };
type ApiDescriptionBlock = { html: string; code?: ApiCodeBlock };
type ApiExport = {
	id: string;
	level: number;
	name: string;
	kind: string | null;
	description: ApiDescriptionBlock[];
	signature: ApiCodeBlock | null;
	examples: ApiCodeBlock[];
	source: string | null;
	since: string | null;
};
type ApiModule = {
	name: string;
	since: string | null;
	description: ApiDescriptionBlock[];
	sourceUrl: string | null;
	categories: { id: string; title: string; exports: ApiExport[] }[];
};

// The JSON snapshots are read with node:fs at build time (never imported), so
// the type checker doesn't try to infer literal types for ~8MB of JSON. Each
// page receives its own module's data via getStaticPaths props.
export function getStaticPaths() {
	const dir = join(process.cwd(), "src/data/apiModules/");
	return readdirSync(dir)
		.filter((file) => file.endsWith(".json"))
		.flatMap((file) => {
			const pkg = file.replace(/\.json$/, "");
			const modules: Record<string, ApiModule> = JSON.parse(
				readFileSync(join(dir, file), "utf8"),
			);
			return Object.entries(modules).map(([module, mod]) => ({
				params: { pkg, module },
				props: { mod },
			}));
		});
}

const { pkg: pkgSlug } = Astro.params;
const { mod } = Astro.props as { mod: ApiModule };
const pkg = API_PACKAGES.find((p) => p.slug === pkgSlug);
if (!pkg) throw new Error(`Unknown API package: ${pkgSlug}`);

const packageDir =
	pkg.slug === "ai"
		? "ai/ai"
		: pkg.slug.startsWith("ai-")
			? `ai/${pkg.slug.slice(3)}`
			: pkg.slug;
const sourceUrl =
	mod.sourceUrl ??
	`https://github.com/Effect-TS/effect/tree/main/packages/${packageDir}/src/${mod.name}.ts`;
const exportCount = mod.categories.reduce((n, c) => n + c.exports.length, 0);

const tocItems: ApiTocItem[] = mod.categories.flatMap((c) => [
	{ id: c.id, label: c.title, depth: 0 },
	...c.exports.map((e) => ({
		id: e.id,
		label: e.name,
		depth: e.level - 1,
	})),
]);

const shikiThemes = { light: "github-light", dark: "github-dark" };
---

<BaseLayout
	themeable
	title={`${mod.name} — ${pkg.name} — Effect API Reference`}
	description={`API reference for the ${mod.name} module of ${pkg.name}.`}
>
	<ApiReferenceLayout
	activeSlug={pkg.slug}
	activeModule={mod.name}
	tocItems={tocItems}
	client:load
>
		<article class="max-w-3xl">
			<nav
				aria-label="Breadcrumb"
				class="mb-6 font-mono text-xs tracking-wider text-zinc-500 uppercase dark:text-zinc-400"
			>
				<a
					href={getAssetPath("/docs/api")}
					class="transition-colors hover:text-zinc-900 dark:hover:text-white"
				>
					API Reference
				</a>
				<span class="mx-2" aria-hidden="true">/</span>
				<a
					href={getAssetPath(`/docs/api/${pkg.slug}`)}
					class="transition-colors hover:text-zinc-900 dark:hover:text-white"
				>
					{pkg.name}
				</a>
				<span class="mx-2" aria-hidden="true">/</span>
				<span class="text-zinc-900 dark:text-white">{mod.name}</span>
			</nav>

			<h1
				class="font-mono text-3xl leading-tight font-bold tracking-tight break-words text-zinc-900 md:text-4xl dark:text-white"
			>
				{mod.name}
			</h1>

			<div
				class="mt-6 flex flex-wrap items-center gap-x-5 gap-y-2 text-sm text-zinc-500 dark:text-zinc-400"
			>
				<span class="font-mono">
					{exportCount} export{exportCount === 1 ? "" : "s"}
				</span>
				{mod.since && <span class="font-mono">Added in v{mod.since}</span>}
				<a
					href={sourceUrl}
					target="_blank"
					rel="noopener noreferrer"
					class="inline-flex items-center gap-1.5 transition-colors hover:text-zinc-900 dark:hover:text-white"
				>
					<i class="ri-github-line text-base" aria-hidden="true"></i>
					Source
					<span class="sr-only">(opens in new tab)</span>
				</a>
			</div>

			{
				mod.description.length > 0 && (
					<div class="api-prose mt-8">
						{mod.description.map((block) => (
							<Fragment set:html={block.html} />
						))}
					</div>
				)
			}

			<div class="mt-8 space-y-14">
				{
					mod.categories.map((category) => (
						<section aria-labelledby={category.id}>
							<h2
								id={category.id}
								class="scroll-mt-24 border-b border-zinc-200 pb-3 text-2xl font-semibold tracking-tight text-zinc-900 dark:border-zinc-800 dark:text-white"
							>
								{category.title}
							</h2>
							<div class="mt-6 space-y-10">
								{category.exports.map((exp) => {
									const Heading = `h${Math.min(exp.level + 1, 6)}` as
										| "h3"
										| "h4"
										| "h5";
									return (
										<section
											aria-labelledby={exp.id}
											class={
												exp.level === 3
													? "ml-5"
													: exp.level >= 4
														? "ml-10"
														: ""
											}
										>
											<Heading
												id={exp.id}
												class="scroll-mt-24 flex flex-wrap items-baseline gap-x-3 gap-y-1 font-mono text-lg font-semibold break-words text-zinc-900 dark:text-white"
											>
												{exp.name}
												{exp.kind && (
													<span class="rounded border border-zinc-200 px-1.5 py-0.5 font-mono text-xs font-normal tracking-wide text-zinc-500 dark:border-zinc-700 dark:text-zinc-400">
														{exp.kind}
													</span>
												)}
											</Heading>
											{exp.description.length > 0 && (
												<div class="api-prose mt-2">
													{exp.description.map((block) =>
														block.code ? (
															<div class="mt-3 overflow-hidden rounded-md border border-zinc-200 bg-white px-4 py-3 dark:border-zinc-800 dark:bg-zinc-900/40">
																<Code
																	code={block.code.code}
																	lang="ts"
																	themes={shikiThemes}
																/>
															</div>
														) : (
															<Fragment set:html={block.html} />
														),
													)}
												</div>
											)}
											{exp.signature && (
												<div class="mt-3 overflow-hidden rounded-md border border-zinc-200 bg-white px-4 py-3 dark:border-zinc-800 dark:bg-zinc-900/40">
													<Code
														code={exp.signature.code}
														lang="ts"
														themes={shikiThemes}
													/>
												</div>
											)}
											{exp.examples.map((example) => (
												<div class="mt-4">
													<p class="mb-2 font-mono text-xs font-medium tracking-wider text-zinc-500 uppercase dark:text-zinc-400">
														Example
													</p>
													<div class="overflow-hidden rounded-md border border-zinc-200 bg-white px-4 py-3 dark:border-zinc-800 dark:bg-zinc-900/40">
														<Code
															code={example.code}
															lang="ts"
															themes={shikiThemes}
														/>
													</div>
												</div>
											))}
											<div class="mt-3 flex flex-wrap items-center gap-x-4 gap-y-1 text-xs text-zinc-500 dark:text-zinc-400">
												{exp.since && (
													<span class="font-mono">Added in v{exp.since}</span>
												)}
												{exp.source && (
													<a
														href={exp.source}
														target="_blank"
														rel="noopener noreferrer"
														class="transition-colors hover:text-zinc-900 dark:hover:text-zinc-300"
													>
														Source
														<span class="sr-only">(opens in new tab)</span>
													</a>
												)}
											</div>
										</section>
									);
								})}
							</div>
						</section>
					))
				}
			</div>
		</article>
	</ApiReferenceLayout>
</BaseLayout>
