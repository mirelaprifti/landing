---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { CommunityResourcesCategoryPage } from "@/components/landing/CommunityResourcesCategoryPage";
import {
	CATEGORIES,
	CATEGORY_DISPLAY_NAMES,
	CATEGORY_SLUGS,
} from "../../data/resources";

export function getStaticPaths() {
	return CATEGORIES.map((cat) => ({
		params: { category: CATEGORY_SLUGS[cat] },
		props: { category: cat },
	}));
}

const { category } = Astro.props;

if (!category) {
	return Astro.redirect("/community-resources");
}

const displayName = CATEGORY_DISPLAY_NAMES[category];
---

<BaseLayout
  title={`${displayName} - Community Resources - Effect`}
  description={`Browse ${displayName.toLowerCase()} built by the Effect community.`}
>
  <CommunityResourcesCategoryPage category={category} client:load />
</BaseLayout>
