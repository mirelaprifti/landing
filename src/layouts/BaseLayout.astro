---
import "../styles/globals.css";

interface Props {
	title?: string;
	description?: string;
	ogImage?: string;
}

const {
	title = "Effect Examples",
	description = "Interactive Effect examples",
	ogImage,
} = Astro.props;

const base = import.meta.env.PROD ? "/landing" : "";
const siteUrl = "https://mirelaprifti.github.io";

function getOgImagePath(): string {
	if (ogImage) return ogImage;
	const pathname = Astro.url.pathname;
	let slug = pathname
		.replace(/^\/landing/, "")
		.replace(/^\//, "")
		.replace(/\/$/, "");
	if (!slug) slug = "index";
	return `/og/${slug}.png`;
}

const ogImagePath = getOgImagePath();
const ogImageUrl = `${siteUrl}${base}${ogImagePath}`;
const pagePathname = Astro.url.pathname.replace(/\/$/, "") || "/";
const canonicalUrl = `${siteUrl}${pagePathname}`;
---

<!doctype html>
<html lang="en" class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <!-- Inter and JetBrains Mono fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@100;200;300;400;500;600;700;800;900&family=JetBrains+Mono:wght@300;400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <!-- Remix Icon -->
    <link
      href="https://cdn.jsdelivr.net/npm/remixicon@4.7.0/fonts/remixicon.css"
      rel="stylesheet"
    />
    <title>{title}</title>

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:site_name" content="Effect" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <!-- Canonical -->
    <link rel="canonical" href={canonicalUrl} />
  </head>
  <body class="min-h-screen bg-zinc-950 text-white antialiased">
    <slot />
  </body>
</html>
