---
import "../styles/globals.css";
import { AnnouncementBanner } from "@/components/landing/AnnouncementBanner";

interface Props {
	title?: string;
	description?: string;
	ogImage?: string;
	/** Pages with a theme switch (blog, playground, docs) resolve light/dark from
	 * the stored/system preference. All other pages are always dark. */
	themeable?: boolean;
	/** Always-light pages (styleguide) — renders dark examples inline instead. */
	light?: boolean;
}

const {
	title = "Effect Examples",
	description = "Interactive Effect examples",
	ogImage,
	themeable = false,
	light = false,
} = Astro.props;

const base = import.meta.env.PROD ? "/landing" : "";
const siteUrl = "https://mirelaprifti.github.io";

function getOgImagePath(): string {
	if (ogImage) return ogImage;
	const pathname = Astro.url.pathname;
	let slug = pathname
		.replace(/^\/landing/, "")
		.replace(/^\//, "")
		.replace(/\/$/, "");
	if (!slug) slug = "index";
	return `/og/${slug}.png`;
}

const ogImagePath = getOgImagePath();
const ogImageUrl = `${siteUrl}${base}${ogImagePath}`;
const pagePathname = Astro.url.pathname.replace(/\/$/, "") || "/";
const canonicalUrl = `${siteUrl}${pagePathname}`;
---

<!doctype html>
<html lang="en" class={light ? undefined : "dark"}>
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL}favicon.svg`} />
    <!-- Inter and JetBrains Mono fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@100;200;300;400;500;600;700;800;900&family=JetBrains+Mono:wght@300;400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <!-- Remix Icon -->
    <link
      href="https://cdn.jsdelivr.net/npm/remixicon@4.7.0/fonts/remixicon.css"
      rel="stylesheet"
    />
    <title>{title}</title>

    <!-- Theme: prevent flash of wrong theme. Only pages with a theme switch
         resolve the preference; all other pages stay dark. -->
    {themeable && (
      <script is:inline>
        (function() {
          var stored = localStorage.getItem('theme');
          var prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
          if (stored === 'light') {
            document.documentElement.classList.remove('dark');
          } else if (stored === 'dark') {
            document.documentElement.classList.add('dark');
          } else {
            // system mode (default)
            if (prefersDark) {
              document.documentElement.classList.add('dark');
            } else {
              document.documentElement.classList.remove('dark');
            }
          }
        })();
      </script>
    )}

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:site_name" content="Effect" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <!-- Canonical -->
    <link rel="canonical" href={canonicalUrl} />
    <!-- Announcement banner: decide visibility before first paint so a
         dismissed banner never flashes and the fixed navbar never jumps -->
    <script is:inline>
      try {
        if (!localStorage.getItem("effect-days-2026-banner-dismissed")) {
          document.documentElement.classList.add("has-announcement");
        }
      } catch (_) {
        document.documentElement.classList.add("has-announcement");
      }
    </script>
  </head>
  <body class="min-h-screen bg-white text-zinc-900 antialiased dark:bg-zinc-950 dark:text-white">
    <AnnouncementBanner client:load />
    <slot />
  </body>
</html>
